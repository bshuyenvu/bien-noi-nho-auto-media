PORT=8787
RENDER_API_KEY=

# Dell Wyse 5060 / 4 GB safe-render defaults.
LOW_MEMORY_MODE=true
RENDER_QUEUE_PAUSED=false
RENDER_MIN_AVAILABLE_MB=512
RENDER_MAX_LOAD_PER_CPU=0.85
RENDER_RESOURCE_POLL_MS=10000
RENDER_RESOURCE_MAX_WAIT_MS=900000
RENDER_MIN_FREE_DISK_MB=2048
RENDER_MAX_OUTPUT_MB=8192
RENDER_OUTPUT_RETENTION_HOURS=72
RENDER_WATCHDOG_MS=1200000
RENDER_MAX_ATTEMPTS=3
RENDER_RETRY_BASE_MS=15000
TTS_TIMEOUT_MS=300000
FFMPEG_TIMEOUT_MS=1800000
SHUTDOWN_GRACE_MS=5000

# Encrypted publisher credential vault.
CREDENTIAL_VAULT_KEY=
# Separate signing key for short-lived OAuth state; may be same strength as vault key but keep distinct in production.
OAUTH_STATE_SECRET=
# Global kill switch. Keep false until provider OAuth has been connected and tested.
PUBLISH_LIVE_ENABLED=false
PUBLISH_WORKER_INTERVAL_MS=15000

# YouTube OAuth + resumable upload + live readiness.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Must exactly match an authorized redirect URI in Google Cloud, and production should use HTTPS.
YOUTUBE_REDIRECT_URI=https://your-domain.example/publish-oauth/youtube/callback
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_CATEGORY_ID=22
YOUTUBE_UPLOAD_CHUNK_BYTES=8388608
YOUTUBE_CONTAINS_SYNTHETIC_MEDIA=true
# A successful channel/token readiness test remains valid for 15 minutes by default.
YOUTUBE_READINESS_MAX_AGE_MS=900000

AI_API_URL=
AI_API_KEY=
AI_MODEL=
OLLAMA_ENABLED=false
OLLAMA_API_URL=http://host.docker.internal:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen2.5:14b
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
VIENEU_TTS_ENABLED=false
VIENEU_TTS_URL=http://vieneu-tts:7861
VIENEU_TTS_TIMEOUT_MS=240000
VIENEU_MODE=v3nano
AUTOPILOT_ENABLED=true
AUTOPILOT_INTERVAL_MINUTES=15
AUTOPILOT_LENGTH=60
AUTOPILOT_FORMAT=latest
AUTOPILOT_TEMPLATE=clean
AUTOPILOT_MOTION=light
AUTOPILOT_MAX_PER_DAY=24
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
ADMIN_CLERK_USER_IDS=
DEFAULT_CHANNEL_NAME=Biển & Nỗi Nhớ

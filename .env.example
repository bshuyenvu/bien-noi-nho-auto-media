PORT=8787
RENDER_API_KEY=

# Optional AI editor using an OpenAI-compatible endpoint.
# Leave blank to use the built-in local editor.
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# AI provider chain: Ollama local -> legacy AI_API -> Gemini -> rules fallback.
# Enable only after Ollama is installed and the model has been pulled on the host.
OLLAMA_ENABLED=false
OLLAMA_API_URL=http://host.docker.internal:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen2.5:14b

# Optional Gemini fallback. API billing/quota is separate from Google AI Pro.
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional, fully local VieNeu v3 (Apache-2.0). Run scripts/check-vieneu.sh
# before enabling. Dell Wyse/4 GB should use v3nano; Edge remains fallback.
VIENEU_TTS_ENABLED=false
VIENEU_TTS_URL=http://vieneu-tts:7861
VIENEU_TTS_TIMEOUT_MS=240000
VIENEU_MODE=v3nano

# Unattended RSS → edit → voice → render pipeline
AUTOPILOT_ENABLED=true
AUTOPILOT_INTERVAL_MINUTES=15
AUTOPILOT_LENGTH=60
AUTOPILOT_FORMAT=latest
AUTOPILOT_TEMPLATE=clean
AUTOPILOT_MOTION=light
AUTOPILOT_MAX_PER_DAY=24

# VietNewsFlow AI membership (Clerk)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Comma-separated Clerk user IDs promoted to admin on first login
ADMIN_CLERK_USER_IDS=
DEFAULT_CHANNEL_NAME=Biển & Nỗi Nhớ

PORT=8787
# Secure default for a reverse proxy on the same host. Use 0.0.0.0 only when LAN access is intentional.
BIND_ADDRESS=127.0.0.1
NODE_OPTIONS=--max-old-space-size=768
APP_MEM_LIMIT=2800m
APP_CPUS=2.0
APP_IMAGE_TAG=current
DB_PATH=/app/data/auto-media.sqlite
RENDER_OUTPUT_DIR=/app/output
RENDER_API_KEY=

# Dell Wyse 5060 / 4 GB safe-render defaults.
LOW_MEMORY_MODE=true
RENDER_QUEUE_PAUSED=false
RENDER_MIN_AVAILABLE_MB=512
RENDER_MAX_LOAD_PER_CPU=0.85
RENDER_RESOURCE_POLL_MS=10000
RENDER_RESOURCE_MAX_WAIT_MS=900000
RENDER_MIN_FREE_DISK_MB=2048
RENDER_MAX_OUTPUT_MB=8192
RENDER_OUTPUT_RETENTION_HOURS=72
RENDER_WATCHDOG_MS=1200000
RENDER_MAX_ATTEMPTS=3
RENDER_RETRY_BASE_MS=15000
TTS_TIMEOUT_MS=300000
FFMPEG_TIMEOUT_MS=1800000
SHUTDOWN_GRACE_MS=5000

# Phase 4.2 production monitoring. Red thresholds still use the render guards plus cgroup critical memory.
MONITOR_INTERVAL_MS=30000
MONITOR_WARN_AVAILABLE_MB=768
MONITOR_WARN_LOAD_PER_CPU=0.70
MONITOR_WARN_CGROUP_MEMORY_PCT=75
MONITOR_CRIT_CGROUP_MEMORY_PCT=90
MONITOR_WARN_RENDER_BACKLOG=5
MONITOR_WARN_PUBLISH_BACKLOG=20
MONITOR_PUBLISH_STUCK_MS=900000
MONITOR_HISTORY_DAYS=30

# Phase 4.3 safe self-healing. This ONLY pauses/resumes Render Queue; it never changes YouTube LIVE settings.
SELF_HEAL_ENABLED=true
# Resume only after this many consecutive GREEN memory+disk monitor cycles.
SELF_HEAL_GREEN_CYCLES=3

# Phase 4.3 external alerting. Secrets stay server-side in .env only.
# Default sends only RED incidents; recovery is sent only if the incident previously produced an alert.
ALERT_MIN_SEVERITY=red
ALERT_COOLDOWN_MS=3600000
ALERT_FAILURE_RETRY_MS=300000
ALERT_NOTIFY_RECOVERY=true
ALERT_SEND_TIMEOUT_MS=7000
# Generic webhook: HTTPS is required in production. HTTP can be enabled only for trusted local testing.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_BEARER_TOKEN=
ALERT_WEBHOOK_ALLOW_HTTP=false
# Telegram Bot API sendMessage.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_TELEGRAM_THREAD_ID=
# SMTP email alerts. Port 465 normally uses secure=true; port 587 normally uses STARTTLS with secure=false.
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_SECURE=false
ALERT_SMTP_USER=
ALERT_SMTP_PASS=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Encrypted publisher credential vault.
CREDENTIAL_VAULT_KEY=
# Use a distinct, high-entropy signing key in production.
OAUTH_STATE_SECRET=
# Global kill switch. Keep false until OAuth + connection test are ready.
PUBLISH_LIVE_ENABLED=false
PUBLISH_WORKER_INTERVAL_MS=15000
# Print safe configuration diagnostics at startup (never prints secrets).
PUBLISH_STARTUP_DIAGNOSTICS=true
# Optional: refuse production LIVE startup when required publisher config is missing.
PUBLISH_STRICT_STARTUP=false

# YouTube OAuth + resumable upload + production readiness.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Must exactly match an authorized redirect URI in Google Cloud. Production should use HTTPS.
YOUTUBE_REDIRECT_URI=https://your-domain.example/api/publish-oauth/youtube/callback
# Start with private. Before changing to unlisted/public, complete a Private Live Test in the UI.
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_CATEGORY_ID=22
# For chunked resumable upload this must be a multiple of 256 KiB; 8 MiB is Wyse-friendly.
YOUTUBE_UPLOAD_CHUNK_BYTES=8388608
YOUTUBE_CONTAINS_SYNTHETIC_MEDIA=true
# A successful channel/token readiness test remains valid for 15 minutes by default.
YOUTUBE_READINESS_MAX_AGE_MS=900000

AI_API_URL=
AI_API_KEY=
AI_MODEL=
OLLAMA_ENABLED=false
OLLAMA_API_URL=http://host.docker.internal:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen2.5:14b
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
VIENEU_TTS_ENABLED=false
VIENEU_TTS_URL=http://vieneu-tts:7861
VIENEU_TTS_TIMEOUT_MS=240000
VIENEU_MODE=v3nano
AUTOPILOT_ENABLED=true
AUTOPILOT_INTERVAL_MINUTES=15
AUTOPILOT_LENGTH=60
AUTOPILOT_FORMAT=latest
AUTOPILOT_TEMPLATE=clean
AUTOPILOT_MOTION=light
AUTOPILOT_MAX_PER_DAY=24
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
ADMIN_CLERK_USER_IDS=
DEFAULT_CHANNEL_NAME=Biển & Nỗi Nhớ

# Local operator check. PROD_CHECK_URL points to the exposed app URL from the machine running the check.
PROD_CHECK_URL=http://127.0.0.1:8787
PROD_CHECK_TIMEOUT_MS=5000
PROD_CHECK_STRICT=false

# Phase 4.1 one-command production operations.
DEPLOY_HEALTH_URL=http://127.0.0.1:8787/health
DEPLOY_HEALTH_RETRIES=40
DEPLOY_HEALTH_SLEEP_SECONDS=3
DEPLOY_STRICT_CHECK=false
DEPLOY_KEEP_ROLLBACK_IMAGES=3
BACKUP_RETENTION_COUNT=7

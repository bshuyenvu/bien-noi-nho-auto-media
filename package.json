    "smoke:ui": "node scripts/smoke-ui.mjs",
    "tts:demo": "tsx src/cli-tts.ts",
    "video:demo": "tsx src/cli-video.ts",
    "smoke:editorial-intelligence": "tsx scripts/smoke-editorial-intelligence.ts",
    "smoke:editorial-llm-live": "tsx scripts/smoke-editorial-llm-live.ts",
    "smoke:rss-resilience": "tsx scripts/smoke-rss-source-resilience.ts",
    "smoke:editorial-professional": "tsx scripts/smoke-editorial-professional-v2.ts",
    "smoke:shotcraft-lite": "tsx scripts/smoke-shotcraft-lite.ts",
    "smoke:shotcraft-render": "node scripts/smoke-shotcraft-render.mjs",
    "smoke:shotcraft-manifest": "tsx scripts/smoke-shotcraft-manifest.ts",

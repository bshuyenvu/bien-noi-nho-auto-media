    "smoke:multilingual-source": "tsx scripts/smoke-multilingual-source.ts",
    "smoke:evidence-gate": "tsx scripts/smoke-evidence-gate.ts",
    "smoke:claim-source-matrix": "tsx scripts/smoke-claim-source-matrix.ts",
    "smoke:provider-capabilities": "tsx scripts/smoke-provider-capabilities.ts",
    "smoke:safe-export-handoff": "tsx scripts/smoke-safe-export-handoff.ts",
    "smoke:monitoring": "tsx scripts/smoke-monitoring.ts",
    "smoke:self-heal-alerts": "tsx scripts/smoke-self-heal-alerts.ts",
    "smoke:maintenance": "tsx scripts/smoke-maintenance.ts",
    "smoke:audit": "tsx scripts/smoke-audit.ts",
    "smoke:analytics": "tsx scripts/smoke-analytics.ts",
    "smoke:ops-assistant": "tsx scripts/smoke-ops-assistant.ts",
    "smoke:durable-queue": "tsx scripts/smoke-durable-queue.ts",
    "smoke:review-gate": "tsx scripts/smoke-review-gate.ts",
    "smoke:artifact-integrity": "tsx scripts/smoke-artifact-integrity.ts",
    "smoke:consistency": "tsx scripts/smoke-consistency.ts",
    "smoke:youtube-resumable": "tsx scripts/smoke-youtube-resumable.ts",
    "smoke:release-candidate": "tsx scripts/smoke-release-candidate.ts",
    "smoke:activation-wizard": "tsx scripts/smoke-activation-wizard.ts",
    "smoke:youtube-canary": "tsx scripts/smoke-youtube-canary.ts",
    "smoke:public-rollout": "tsx scripts/smoke-public-rollout.ts && node --check scripts/public-rollout-client.mjs && bash -n scripts/public-rollout.sh",
    "smoke:public-ramp": "tsx scripts/smoke-public-ramp.ts",
    "smoke:content-safety": "tsx scripts/smoke-content-safety.ts",

{
  "name": "vietnewsflow-ai",
  "version": "6.4.0",
  "private": true,
  "description": "Multi-tenant Vietnamese AI newsroom and automated short-video platform",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "start:dev": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "prod:check": "node scripts/production-check.mjs",
    "smoke:production": "node scripts/smoke-production-start.mjs",
    "smoke:wyse-ops": "bash scripts/smoke-wyse-ops.sh",
    "smoke:v1-private-deploy": "bash scripts/smoke-v1-private-deploy.sh",

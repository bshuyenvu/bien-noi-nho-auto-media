  "dependencies": {
    "@clerk/express": "^2.1.66",
    "cheerio": "^1.1.2",
    "dotenv": "^17.4.2",
    "edge-tts-universal": "^1.4.0",
    "express": "^5.1.0",
    "nodemailer": "^10.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
